{
  "name": "spacetime-mud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:server": "tsc --noEmit -p spacetimedb/tsconfig.json",
    "bridge": "tsx bridge/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:timers": "tsx tests/timers.ts",
    "test:browser": "tsx tests/browser.ts",
    "test:bridge": "tsx tests/bridge-live.ts",
    "build:interpreter": "node scripts/bundle-interpreter.mjs",
    "test:poc": "tsx --test tests/box-world.test.ts",
    "test:poc:browser": "tsx tests/box-world-browser.ts",
    "test:visual": "tsx tests/visual-integration.ts",
    "test:visual:browser": "tsx tests/visual-browser.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "spacetimedb": "2.13.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.6.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
