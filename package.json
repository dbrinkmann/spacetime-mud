{
  "name": "spacetime-mud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:server": "tsc --noEmit -p spacetimedb/tsconfig.json",
    "check:runtime": "tsc --noEmit -p world-server/tsconfig.json",
    "test:runtime": "tsx --test tests/runtime*.test.ts",
    "test:runtime:local": "tsx tests/runtime-local.ts",
    "test:runtime:access": "tsx tests/runtime-access-local.ts",
    "test:runtime:mcp": "tsx tests/runtime-mcp-local.ts",
    "test:runtime:browser": "tsx tests/runtime-workbench.ts",
    "test:runtime:social": "tsx tests/runtime-social-local.ts",
    "test:runtime:preview": "tsx tests/runtime-preview.ts",
    "build:runtime:agent": "tsx scripts/build-runtime-agent.ts",
    "bridge": "tsx bridge/index.ts",
    "discord:gateway": "tsx gateway/index.ts",
    "build:staging": "tsx scripts/build-discord-staging.ts",
    "build:agent": "tsx scripts/build-community-agent.ts",
    "mcp:community": "tsx mcp/community.ts",
    "mcp:runtime": "tsx mcp/runtime-main.ts",
    "test:community:agent": "tsx tests/community-agent.ts",
    "test:community:agent:browser": "tsx tests/community-agent-browser.ts",
    "test:community": "tsx tests/community.ts",
    "test:community:browser": "tsx tests/community-browser.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:timers": "tsx tests/timers.ts",
    "test:browser": "tsx tests/browser.ts",
    "test:bridge": "tsx tests/bridge-live.ts",
    "build:interpreter": "node scripts/bundle-interpreter.mjs",
    "test:poc": "tsx --test tests/box-world.test.ts",
    "test:poc:browser": "tsx tests/box-world-browser.ts",
    "test:visual": "tsx tests/visual-integration.ts",
    "test:visual:browser": "tsx tests/visual-browser.ts",
    "mcp": "tsx mcp/index.ts",
    "agent:config": "tsx scripts/agent-config.ts",
    "test:agent": "tsx tests/agent-mcp.ts",
    "test:builder:browser": "tsx tests/builder-browser.ts",
    "test:builder:preview": "tsx tests/builder-preview.ts",
    "test:community:scripts": "tsx tests/community-scripts.ts",
    "test:community:scripts:browser": "tsx tests/community-scripts-browser.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@discord/embedded-app-sdk": "2.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "spacetimedb": "2.13.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.6.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
